generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum SkillSelfAssessmentStatus {
  PENDING
  APPROVED
  CORRECTED
  REJECTED
}

enum SkillLevelChangeSource {
  ASSESSMENT_APPROVED
  ASSESSMENT_CORRECTED
  DIRECT_EDIT
  BACKFILL
  /// CSV で取り込んだレベル。成長の演出・フィードには出さない
  CSV_IMPORT
}

enum SkillPrerequisiteSource {
  AI_SUGGESTION
  MANUAL
}

enum LevelUpReactionType {
  CONGRATS
  AMAZING
  WANT_TO_LEARN
}

enum NotificationType {
  SKILL_ASSESSMENT_REQUESTED
  SKILL_ASSESSMENT_APPROVED
  SKILL_ASSESSMENT_CORRECTED
  SKILL_ASSESSMENT_REJECTED
  LEVEL_UP_COMMENTED
  LEVEL_UP_REACTED
  CHEER_RECEIVED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum CsvImportTargetType {
  SKILLS
  MEMBER_SKILLS
  ROLES
}

enum CsvImportStatus {
  UPLOADED
  VALIDATED
  APPLIED
  FAILED
  CANCELED
}

enum GrowthHintSource {
  AI
  FALLBACK
}

enum ProposalSheetDraftSource {
  AI
  FALLBACK
  MANUAL
}

enum AiUsageStatus {
  SUCCESS
  FAILED
  FALLBACK
}

enum AiJobKind {
  GROWTH_HINT
  PROPOSAL_SHEET
  SKILL_PREREQUISITE
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TeamGoalKind {
  LEVEL_UP_COUNT
  LEVEL_UP_MEMBERS
  SKILL_REACH
}

model Member {
  id                    String                @id @default(cuid())
  tenantId              String                @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  platformUserId        String
  status                MemberStatus          @default(ACTIVE)
  profile               String?
  profileMessage        String?
  consultTopics         String[]              @default([])
  isProfilePublic       Boolean               @default(true)
  targetRoleId          String?
  targetRole            Role?                 @relation("MemberTargetRole", fields: [targetRoleId], references: [id])
  lastRecapSeenMonth    String?
  memberSkills          MemberSkill[]         @relation("MemberSkills")
  approvedMemberSkills  MemberSkill[]         @relation("ApprovedMemberSkills")
  selfAssessments       SkillSelfAssessment[] @relation("AssessmentMember")
  reviewedAssessments   SkillSelfAssessment[] @relation("AssessmentReviewer")
  notifications         Notification[]        @relation("NotificationRecipient")
  actedNotifications    Notification[]        @relation("NotificationActor")
  auditLogs             AuditLog[]            @relation("AuditActor")
  skillLevelChanges     SkillLevelChange[]    @relation("SkillLevelChangeMember")
  changedSkillLevels    SkillLevelChange[]    @relation("SkillLevelChangeActor")
  levelUpReactions      LevelUpReaction[]     @relation("LevelUpReactionMember")
  levelUpComments       LevelUpComment[]      @relation("LevelUpCommentAuthor")
  sentCheers            Cheer[]               @relation("CheerSender")
  receivedCheers        Cheer[]               @relation("CheerRecipient")
  mentoredCheers        Cheer[]               @relation("CheerMentor")
  managedOneOnOneNotes  OneOnOneNote[]        @relation("OneOnOneNoteManager")
  receivedOneOnOneNotes OneOnOneNote[]        @relation("OneOnOneNoteMember")
  growthHint            GrowthHint?           @relation("GrowthHintMember")
  generatedGrowthHints  GrowthHint[]          @relation("GrowthHintGeneratedBy")
  aiUsageLogs           AiUsageLog[]          @relation("AiUsageActor")
  createdSkillPrerequisites SkillPrerequisite[] @relation("SkillPrerequisiteCreatedBy")
  teamGoals             TeamGoal[]             @relation("TeamGoalManager")
  teamGoalAcknowledgements TeamGoalAcknowledgement[]
  roleAchievements      RoleAchievement[]
  projectHistories      MemberProjectHistory[]
  certifications        MemberCertification[]
  proposalSheetDraft    ProposalSheetDraft?   @relation("ProposalSheetDraftMember")
  updatedProposalSheets ProposalSheetDraft[]   @relation("ProposalSheetDraftUpdatedBy")
  updatedSkillSheetTemplates SkillSheetTemplate[] @relation("SkillSheetTemplateUpdatedBy")
  targetedAiJobs         AiJob[]               @relation("AiJobTargetMember")
  requestedAiJobs        AiJob[]               @relation("AiJobRequestedByMember")
  itCareerStartMonth    String?
  skillSheetNote        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([tenantId, platformUserId])
  @@index([status])
  @@index([targetRoleId])
}

model MemberProjectHistory {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title        String
  startMonth   String
  endMonth     String?
  industry     String
  summary      String
  role         String
  teamSize     String
  businessArea String?
  phases       String[]
  technologies String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([memberId, startMonth])
}

model MemberCertification {
  id            String   @id @default(cuid())
  tenantId      String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name          String
  acquiredMonth String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([memberId])
}

model SkillCategory {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  name         String
  displayOrder Int      @default(0)
  groupId      String?
  group        SkillCategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  skills       Skill[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([groupId])
}

model SkillCategoryGroup {
  id           String          @id @default(cuid())
  tenantId     String          @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  name         String
  displayOrder Int             @default(0)
  categories   SkillCategory[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, name])
}

model Skill {
  id                String                @id @default(cuid())
  tenantId          String                @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  code              String
  name              String
  categoryId        String
  category          SkillCategory         @relation(fields: [categoryId], references: [id])
  description       String?
  isActive          Boolean               @default(true)
  displayOrder      Int                   @default(0)
  memberSkills      MemberSkill[]
  selfAssessments   SkillSelfAssessment[]
  roleRequirements  RoleRequirement[]
  skillLevelChanges SkillLevelChange[]
  cheers            Cheer[]
  levelGuides       SkillLevelGuide[]
  prerequisites     SkillPrerequisite[]   @relation("SkillPrerequisites")
  requiredBy        SkillPrerequisite[]   @relation("PrerequisiteSkill")
  teamGoals         TeamGoal[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, categoryId, name])
  @@index([categoryId])
}

model TeamGoal {
  id          String       @id @default(cuid())
  tenantId    String       @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  managerId   String
  manager     Member       @relation("TeamGoalManager", fields: [managerId], references: [id], onDelete: Cascade)
  kind        TeamGoalKind
  skillId     String?
  skill       Skill?       @relation(fields: [skillId], references: [id], onDelete: Restrict)
  targetLevel Int?
  targetCount Int
  note        String?
  startMonth  String
  months      Int
  achievedAt  DateTime?
  acknowledgements TeamGoalAcknowledgement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([managerId, createdAt])
}

model TeamGoalAcknowledgement {
  id         String   @id @default(cuid())
  tenantId   String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  teamGoalId String
  teamGoal   TeamGoal @relation(fields: [teamGoalId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([tenantId, teamGoalId, memberId])
}

model SkillPrerequisite {
  id                  String                  @id @default(cuid())
  tenantId            String                  @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  skillId             String
  skill               Skill                   @relation("SkillPrerequisites", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisiteSkillId String
  prerequisiteSkill   Skill                   @relation("PrerequisiteSkill", fields: [prerequisiteSkillId], references: [id], onDelete: Cascade)
  source              SkillPrerequisiteSource
  createdById         String?
  createdBy           Member?                 @relation("SkillPrerequisiteCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime                @default(now())

  @@unique([tenantId, skillId, prerequisiteSkillId])
  @@index([prerequisiteSkillId])
}

model SkillLevelGuide {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, skillId, level])
  @@index([skillId])
}

model SkillLevel {
  level            Int                   @id
  label            String
  description      String
  memberSkills     MemberSkill[]
  selfAssessments  SkillSelfAssessment[]
  roleRequirements RoleRequirement[]
}

model MemberSkill {
  id                 String     @id @default(cuid())
  tenantId           String     @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId           String
  member             Member     @relation("MemberSkills", fields: [memberId], references: [id])
  skillId            String
  skill              Skill      @relation(fields: [skillId], references: [id])
  level              Int
  skillLevel         SkillLevel @relation(fields: [level], references: [level])
  yearsOfExperience  Decimal?   @db.Decimal(4, 1)
  lastAssessedAt     DateTime?  @db.Date
  approvedByMemberId String?
  approvedByMember   Member?    @relation("ApprovedMemberSkills", fields: [approvedByMemberId], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([tenantId, memberId, skillId])
  @@index([skillId])
  @@index([approvedByMemberId])
}

model SkillSelfAssessment {
  id                  String                    @id @default(cuid())
  tenantId            String                    @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId            String
  member              Member                    @relation("AssessmentMember", fields: [memberId], references: [id])
  skillId             String
  skill               Skill                     @relation(fields: [skillId], references: [id])
  requestedLevel      Int
  requestedSkillLevel SkillLevel                @relation(fields: [requestedLevel], references: [level])
  yearsOfExperience   Decimal?                  @db.Decimal(4, 1)
  status              SkillSelfAssessmentStatus @default(PENDING)
  managerComment      String?
  applicantComment    String?
  reviewedByMemberId  String?
  reviewedByMember    Member?                   @relation("AssessmentReviewer", fields: [reviewedByMemberId], references: [id])
  reviewedAt          DateTime?
  notifications       Notification[]
  skillLevelChanges   SkillLevelChange[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([tenantId])
  @@index([memberId])
  @@index([skillId])
  @@index([status])
  @@index([reviewedByMemberId])
}

model Notification {
  id                    String               @id @default(cuid())
  tenantId              String               @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  recipientMemberId     String
  recipientMember       Member               @relation("NotificationRecipient", fields: [recipientMemberId], references: [id])
  actorMemberId          String?
  actorMember            Member?              @relation("NotificationActor", fields: [actorMemberId], references: [id])
  type                  NotificationType
  status                NotificationStatus   @default(UNREAD)
  skillSelfAssessmentId String?
  skillSelfAssessment   SkillSelfAssessment? @relation(fields: [skillSelfAssessmentId], references: [id])
  skillLevelChangeId    String?
  skillLevelChange      SkillLevelChange?    @relation(fields: [skillLevelChangeId], references: [id])
  cheerId               String?
  cheer                 Cheer?               @relation(fields: [cheerId], references: [id])
  title                 String
  body                  String?
  createdAt             DateTime             @default(now())
  readAt                DateTime?

  @@index([tenantId])
  @@index([recipientMemberId, status])
  @@index([actorMemberId])
  @@index([skillSelfAssessmentId])
  @@index([skillLevelChangeId])
  @@index([cheerId])
}

model Role {
  id               String            @id @default(cuid())
  tenantId         String            @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  code             String
  name             String
  description      String?
  isActive         Boolean           @default(true)
  roleRequirements RoleRequirement[]
  targetMembers    Member[]          @relation("MemberTargetRole")
  roleAchievements RoleAchievement[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model RoleAchievement {
  id               String   @id @default(cuid())
  tenantId         String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  achievedAt       DateTime
  achievedAsTarget Boolean
  celebratedAt     DateTime?
  requirements     Json
  createdAt        DateTime @default(now())

  @@unique([tenantId, memberId, roleId])
  @@index([roleId])
}

model SkillLevelChange {
  id                    String                 @id @default(cuid())
  tenantId              String                 @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId              String
  member                Member                 @relation("SkillLevelChangeMember", fields: [memberId], references: [id])
  skillId               String
  skill                 Skill                  @relation(fields: [skillId], references: [id])
  fromLevel             Int?
  toLevel               Int?
  source                SkillLevelChangeSource
  skillSelfAssessmentId String?
  skillSelfAssessment   SkillSelfAssessment?   @relation(fields: [skillSelfAssessmentId], references: [id])
  changedByMemberId     String?
  changedByMember       Member?                @relation("SkillLevelChangeActor", fields: [changedByMemberId], references: [id])
  changedAt             DateTime               @default(now())
  createdAt             DateTime               @default(now())
  reactions             LevelUpReaction[]
  comments              LevelUpComment[]
  notifications         Notification[]

  @@index([tenantId])
  @@index([memberId, changedAt])
  @@index([changedAt])
  @@index([skillSelfAssessmentId])
}

model LevelUpReaction {
  id            String              @id @default(cuid())
  tenantId      String              @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  levelChangeId String
  levelChange   SkillLevelChange    @relation(fields: [levelChangeId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member              @relation("LevelUpReactionMember", fields: [memberId], references: [id])
  type          LevelUpReactionType
  createdAt     DateTime            @default(now())

  @@unique([tenantId, levelChangeId, memberId, type])
  @@index([memberId])
}

model LevelUpComment {
  id             String           @id @default(cuid())
  tenantId       String           @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  levelChangeId  String
  levelChange    SkillLevelChange @relation(fields: [levelChangeId], references: [id], onDelete: Cascade)
  authorMemberId String
  authorMember   Member           @relation("LevelUpCommentAuthor", fields: [authorMemberId], references: [id])
  body           String
  createdAt      DateTime         @default(now())

  @@index([tenantId])
  @@index([levelChangeId, createdAt])
}

model Cheer {
  id             String         @id @default(cuid())
  tenantId       String         @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  fromMemberId   String
  fromMember     Member         @relation("CheerSender", fields: [fromMemberId], references: [id])
  toMemberId     String
  toMember       Member         @relation("CheerRecipient", fields: [toMemberId], references: [id])
  message        String
  targetSkillId  String?
  targetSkill    Skill?         @relation(fields: [targetSkillId], references: [id])
  mentorMemberId String?
  mentorMember   Member?        @relation("CheerMentor", fields: [mentorMemberId], references: [id])
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([tenantId])
  @@index([toMemberId, createdAt])
  @@index([mentorMemberId])
}

model OneOnOneNote {
  id              String    @id @default(cuid())
  tenantId        String    @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  managerMemberId String
  managerMember   Member    @relation("OneOnOneNoteManager", fields: [managerMemberId], references: [id])
  memberId        String
  member          Member    @relation("OneOnOneNoteMember", fields: [memberId], references: [id])
  body            String
  discussedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([managerMemberId, memberId])
}

model RoleRequirement {
  id            String     @id @default(cuid())
  tenantId      String     @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  skillId       String
  skill         Skill      @relation(fields: [skillId], references: [id])
  requiredLevel Int
  skillLevel    SkillLevel @relation(fields: [requiredLevel], references: [level])
  isRequired    Boolean    @default(true)
  anyOfGroup    Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([tenantId, roleId, skillId])
  @@index([skillId])
}

model AuditLog {
  id             String        @id @default(cuid())
  tenantId       String        @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  actorMemberId  String?
  actorMember    Member?       @relation("AuditActor", fields: [actorMemberId], references: [id])
  action         String
  targetType     String
  targetId       String?
  before         Json?
  after          Json?
  metadata       Json?
  csvImportJobId String?
  csvImportJob   CsvImportJob? @relation(fields: [csvImportJobId], references: [id])
  occurredAt     DateTime      @default(now())

  @@index([tenantId])
  @@index([actorMemberId])
  @@index([targetType, targetId])
  @@index([csvImportJobId])
  @@index([occurredAt])
}

model CsvImportJob {
  id           String              @id @default(cuid())
  tenantId     String              @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  targetType   CsvImportTargetType
  status       CsvImportStatus     @default(UPLOADED)
  originalName String?
  totalRows    Int                 @default(0)
  validRows    Int                 @default(0)
  errorRows    Int                 @default(0)
  summary      Json?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  auditLogs    AuditLog[]

  @@index([tenantId])
  @@index([targetType, status])
}

model GrowthHint {
  id            String           @id @default(cuid())
  tenantId      String           @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId      String           @unique
  member        Member           @relation("GrowthHintMember", fields: [memberId], references: [id], onDelete: Cascade)
  source        GrowthHintSource
  inputHash     String
  content       Json
  model         String?
  generatedById String?
  generatedBy   Member?          @relation("GrowthHintGeneratedBy", fields: [generatedById], references: [id])
  generatedAt   DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId])
}

model ProposalSheetDraft {
  id                  String                   @id @default(cuid())
  tenantId            String                   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  memberId            String                   @unique
  member              Member                   @relation("ProposalSheetDraftMember", fields: [memberId], references: [id], onDelete: Cascade)
  displayName         String
  customerRequest     String
  projectHistoryIds   String[]
  excludedSkillIds    String[]
  selfPr              String
  strengths           String
  projectDescriptions Json
  source              ProposalSheetDraftSource
  inputHash           String?
  model               String?
  generatedAt         DateTime?
  updatedById         String?
  updatedBy           Member?                  @relation("ProposalSheetDraftUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([tenantId])
  @@index([updatedById])
}

model SkillSheetTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(50)
  fileName    String   @db.VarChar(200)
  content     Bytes
  sizeBytes   Int
  useCount    Int      @default(0)
  lastUsedAt  DateTime?
  updatedById String?
  updatedBy   Member?  @relation("SkillSheetTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([updatedById])
}

model AiUsageLog {
  id               String        @id @default(cuid())
  tenantId         String        @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  feature          String
  actorMemberId    String?
  actorMember      Member?       @relation("AiUsageActor", fields: [actorMemberId], references: [id])
  targetMemberId   String?
  model            String?
  status           AiUsageStatus
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int
  errorCode        String?
  createdAt        DateTime      @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@index([feature, createdAt])
}

model AiJob {
  id                    String       @id @default(cuid())
  tenantId              String       @default(dbgenerated("(current_setting('app.tenant_id'::text, true))::uuid")) @map("tenant_id") @db.Uuid
  kind                  AiJobKind
  status                AiJobStatus  @default(QUEUED)
  targetMemberId        String?
  targetMember          Member?      @relation("AiJobTargetMember", fields: [targetMemberId], references: [id], onDelete: Cascade)
  requestedByMemberId   String
  requestedByMember     Member       @relation("AiJobRequestedByMember", fields: [requestedByMemberId], references: [id], onDelete: Cascade)
  params                Json
  result                Json?
  attempts              Int          @default(0)
  nextRunAt             DateTime     @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?
  errorCode             String?
  model                 String?
  durationMs            Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([tenantId])
  @@index([status, nextRunAt])
  @@index([kind, targetMemberId, status])
}

model HubTenant {
  id          String   @id @db.Uuid
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}
