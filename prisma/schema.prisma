generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  LEAVE
}

enum SkillSelfAssessmentStatus {
  PENDING
  APPROVED
  CORRECTED
  REJECTED
}

enum SkillLevelChangeSource {
  ASSESSMENT_APPROVED
  ASSESSMENT_CORRECTED
  DIRECT_EDIT
  BACKFILL
}

enum LevelUpReactionType {
  CONGRATS
  AMAZING
  WANT_TO_LEARN
}

enum NotificationType {
  SKILL_ASSESSMENT_REQUESTED
  SKILL_ASSESSMENT_APPROVED
  SKILL_ASSESSMENT_CORRECTED
  SKILL_ASSESSMENT_REJECTED
  LEVEL_UP_COMMENTED
  CHEER_RECEIVED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum CsvImportTargetType {
  DEPARTMENTS
  MEMBERS
  SKILLS
  MEMBER_SKILLS
}

enum CsvImportStatus {
  UPLOADED
  VALIDATED
  APPLIED
  FAILED
  CANCELED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  passwordChangeRequired Boolean @default(false)
  role          AuthRole  @default(MEMBER)
  memberId      String?   @unique
  member        Member?   @relation(fields: [memberId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id                 String       @id @default(cuid())
  code               String       @unique
  name               String
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DepartmentHierarchy")
  isActive           Boolean      @default(true)
  members            Member[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([parentDepartmentId])
}

model Member {
  id                    String                @id @default(cuid())
  employeeNo            String                @unique
  name                  String
  email                 String                @unique
  departmentId          String
  department            Department            @relation(fields: [departmentId], references: [id])
  status                MemberStatus          @default(ACTIVE)
  jobTitle              String?
  profile               String?
  managerId             String?
  manager               Member?               @relation("MemberManager", fields: [managerId], references: [id])
  reports               Member[]               @relation("MemberManager")
  targetRoleId          String?
  targetRole            Role?                  @relation("MemberTargetRole", fields: [targetRoleId], references: [id])
  users                 User[]
  memberSkills          MemberSkill[]         @relation("MemberSkills")
  approvedMemberSkills  MemberSkill[]         @relation("ApprovedMemberSkills")
  selfAssessments       SkillSelfAssessment[] @relation("AssessmentMember")
  reviewedAssessments   SkillSelfAssessment[] @relation("AssessmentReviewer")
  notifications         Notification[]        @relation("NotificationRecipient")
  auditLogs             AuditLog[]            @relation("AuditActor")
  skillLevelChanges     SkillLevelChange[]     @relation("SkillLevelChangeMember")
  changedSkillLevels    SkillLevelChange[]     @relation("SkillLevelChangeActor")
  levelUpReactions      LevelUpReaction[]      @relation("LevelUpReactionMember")
  levelUpComments       LevelUpComment[]       @relation("LevelUpCommentAuthor")
  sentCheers            Cheer[]                @relation("CheerSender")
  receivedCheers        Cheer[]                @relation("CheerRecipient")
  mentoredCheers        Cheer[]                @relation("CheerMentor")
  managedOneOnOneNotes  OneOnOneNote[]         @relation("OneOnOneNoteManager")
  receivedOneOnOneNotes OneOnOneNote[]         @relation("OneOnOneNoteMember")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([managerId])
  @@index([targetRoleId])
}

model SkillCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  skills       Skill[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id              String                @id @default(cuid())
  code            String                @unique
  name            String
  categoryId      String
  category        SkillCategory         @relation(fields: [categoryId], references: [id])
  description     String?
  isActive        Boolean               @default(true)
  memberSkills    MemberSkill[]
  selfAssessments SkillSelfAssessment[]
  roleRequirements RoleRequirement[]
  skillLevelChanges SkillLevelChange[]
  cheers            Cheer[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
}

model SkillLevel {
  level            Int                   @id
  label            String
  description      String
  memberSkills     MemberSkill[]
  selfAssessments  SkillSelfAssessment[]
  roleRequirements RoleRequirement[]
}

model MemberSkill {
  id                String     @id @default(cuid())
  memberId          String
  member            Member     @relation("MemberSkills", fields: [memberId], references: [id])
  skillId           String
  skill             Skill      @relation(fields: [skillId], references: [id])
  level             Int
  skillLevel        SkillLevel @relation(fields: [level], references: [level])
  yearsOfExperience Decimal?   @db.Decimal(4, 1)
  lastAssessedAt    DateTime?  @db.Date
  approvedByMemberId String?
  approvedByMember   Member?   @relation("ApprovedMemberSkills", fields: [approvedByMemberId], references: [id])
  approvedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([memberId, skillId])
  @@index([skillId])
  @@index([approvedByMemberId])
}

model SkillSelfAssessment {
  id                 String                    @id @default(cuid())
  memberId           String
  member             Member                    @relation("AssessmentMember", fields: [memberId], references: [id])
  skillId            String
  skill              Skill                     @relation(fields: [skillId], references: [id])
  requestedLevel     Int
  requestedSkillLevel SkillLevel               @relation(fields: [requestedLevel], references: [level])
  yearsOfExperience  Decimal?                  @db.Decimal(4, 1)
  status             SkillSelfAssessmentStatus @default(PENDING)
  managerComment     String?
  reviewedByMemberId String?
  reviewedByMember   Member?                   @relation("AssessmentReviewer", fields: [reviewedByMemberId], references: [id])
  reviewedAt         DateTime?
  notifications      Notification[]
  skillLevelChanges  SkillLevelChange[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([memberId])
  @@index([skillId])
  @@index([status])
  @@index([reviewedByMemberId])
}

model Notification {
  id                    String                @id @default(cuid())
  recipientMemberId     String
  recipientMember       Member                @relation("NotificationRecipient", fields: [recipientMemberId], references: [id])
  type                  NotificationType
  status                NotificationStatus    @default(UNREAD)
  skillSelfAssessmentId String?
  skillSelfAssessment   SkillSelfAssessment?  @relation(fields: [skillSelfAssessmentId], references: [id])
  skillLevelChangeId    String?
  skillLevelChange      SkillLevelChange?      @relation(fields: [skillLevelChangeId], references: [id])
  cheerId               String?
  cheer                 Cheer?                 @relation(fields: [cheerId], references: [id])
  title                 String
  body                  String?
  createdAt             DateTime              @default(now())
  readAt                DateTime?

  @@index([recipientMemberId, status])
  @@index([skillSelfAssessmentId])
  @@index([skillLevelChangeId])
  @@index([cheerId])
}

model Role {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  isActive         Boolean           @default(true)
  roleRequirements RoleRequirement[]
  targetMembers    Member[]          @relation("MemberTargetRole")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SkillLevelChange {
  id                    String                 @id @default(cuid())
  memberId              String
  member                Member                 @relation("SkillLevelChangeMember", fields: [memberId], references: [id])
  skillId               String
  skill                  Skill                  @relation(fields: [skillId], references: [id])
  fromLevel             Int?
  toLevel               Int
  source                SkillLevelChangeSource
  skillSelfAssessmentId String?
  skillSelfAssessment   SkillSelfAssessment?   @relation(fields: [skillSelfAssessmentId], references: [id])
  changedByMemberId     String?
  changedByMember       Member?                @relation("SkillLevelChangeActor", fields: [changedByMemberId], references: [id])
  changedAt             DateTime               @default(now())
  createdAt             DateTime               @default(now())
  reactions             LevelUpReaction[]
  comments              LevelUpComment[]
  notifications         Notification[]

  @@index([memberId, changedAt])
  @@index([changedAt])
  @@index([skillSelfAssessmentId])
}

model LevelUpReaction {
  id            String              @id @default(cuid())
  levelChangeId String
  levelChange   SkillLevelChange    @relation(fields: [levelChangeId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member              @relation("LevelUpReactionMember", fields: [memberId], references: [id])
  type          LevelUpReactionType
  createdAt     DateTime            @default(now())

  @@unique([levelChangeId, memberId, type])
  @@index([memberId])
}

model LevelUpComment {
  id             String           @id @default(cuid())
  levelChangeId  String
  levelChange    SkillLevelChange @relation(fields: [levelChangeId], references: [id], onDelete: Cascade)
  authorMemberId String
  authorMember   Member           @relation("LevelUpCommentAuthor", fields: [authorMemberId], references: [id])
  body           String
  createdAt      DateTime         @default(now())

  @@index([levelChangeId, createdAt])
}

model Cheer {
  id             String         @id @default(cuid())
  fromMemberId   String
  fromMember     Member         @relation("CheerSender", fields: [fromMemberId], references: [id])
  toMemberId     String
  toMember       Member         @relation("CheerRecipient", fields: [toMemberId], references: [id])
  message        String
  targetSkillId  String?
  targetSkill    Skill?         @relation(fields: [targetSkillId], references: [id])
  mentorMemberId String?
  mentorMember   Member?        @relation("CheerMentor", fields: [mentorMemberId], references: [id])
  createdAt      DateTime       @default(now())
  notifications  Notification[]

  @@index([toMemberId, createdAt])
  @@index([mentorMemberId])
}

model OneOnOneNote {
  id              String   @id @default(cuid())
  managerMemberId String
  managerMember   Member   @relation("OneOnOneNoteManager", fields: [managerMemberId], references: [id])
  memberId        String
  member          Member   @relation("OneOnOneNoteMember", fields: [memberId], references: [id])
  body            String
  discussedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([managerMemberId, memberId])
}

model RoleRequirement {
  id            String     @id @default(cuid())
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id])
  skillId       String
  skill         Skill      @relation(fields: [skillId], references: [id])
  requiredLevel Int
  skillLevel    SkillLevel @relation(fields: [requiredLevel], references: [level])
  isRequired    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([roleId, skillId])
  @@index([skillId])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorMemberId  String?
  actorMember    Member?       @relation("AuditActor", fields: [actorMemberId], references: [id])
  action         String
  targetType     String
  targetId       String?
  before         Json?
  after          Json?
  metadata       Json?
  csvImportJobId String?
  csvImportJob   CsvImportJob? @relation(fields: [csvImportJobId], references: [id])
  occurredAt     DateTime      @default(now())

  @@index([actorMemberId])
  @@index([targetType, targetId])
  @@index([csvImportJobId])
  @@index([occurredAt])
}

model CsvImportJob {
  id           String              @id @default(cuid())
  targetType   CsvImportTargetType
  status       CsvImportStatus     @default(UPLOADED)
  originalName String?
  totalRows    Int                 @default(0)
  validRows    Int                 @default(0)
  errorRows    Int                 @default(0)
  summary      Json?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  auditLogs    AuditLog[]

  @@index([targetType, status])
}
