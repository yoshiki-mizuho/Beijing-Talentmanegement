# Local development uses the Docker PostgreSQL connection below.
# Vercel Production must use the pooled Neon connection string (`-pooler` host).
# For `prisma migrate deploy` and the initial seed, temporarily replace this with
# the direct Neon connection string. Never register the direct URL in Vercel.
DATABASE_URL="postgresql://talent:talent_password@localhost:5432/talentmanagement?schema=public"

# Local development example only. Generate a separate long random value for shared environments.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Required only while running `npm run db:seed`.
# Use three different values of at least 12 characters. Do not register them in
# Vercel or commit their real values. Share demo credentials through a private channel.
DEMO_ADMIN_PASSWORD="replace-with-a-unique-admin-password"
DEMO_MANAGER_PASSWORD="replace-with-a-unique-manager-password"
DEMO_MEMBER_PASSWORD="replace-with-a-unique-member-password"

# Example: https://chat.example.com/dm?to={email}
CHAT_LINK_TEMPLATE=
