# The application, seed, and E2E use the RLS-restricted application role.
DATABASE_URL="postgresql://talent_app@localhost:5432/talentmanagement?schema=public"
# Prisma migrations use the table-owner role. In the cluster, the migrate job
# receives its owner connection as DATABASE_URL, so this local-only override is optional.
MIGRATE_DATABASE_URL="postgresql://talent@localhost:5432/talentmanagement?schema=public"
SEED_TENANT_ID="11111111-1111-4111-8111-111111111111"

# Example: https://chat.example.com/dm?to={email}
CHAT_LINK_TEMPLATE=

# Server-only OpenAI-compatible API settings.
# Set AI_API_BASE_URL to fake for local development without network access.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=
AI_MONTHLY_TOKEN_LIMIT=
